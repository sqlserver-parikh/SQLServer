CREATE OR ALTER PROCEDURE [dbo].[usp_PartitionMaintenance]  
    @Action              VARCHAR(20) = 'switchout',                -- REQUIRED. One of: 'SlidingWindow', 'SwitchOut', 'MergeRange', 'Info', 'Aligned'  
    @TableName           VARCHAR(128) = '%TABLENAME',          -- Specific table, or '%'/'' for all partitioned tables  
    @CleanupOlderThan    VARCHAR(10)  = '100d',         -- Used only by @Action='Cleanup'. Format: {number}{d|m|y}, e.g. '30d','6m','1y'  
    @NextPartitionAfter  VARCHAR(10)  = '1y',         -- Used only by @Action='SlidingWindow'. Format: {number}{d|m|y}, may be negative, e.g. '-3m'  
    @Execute             BIT          = 0,            -- 1 = actually execute the generated DDL. Independent of @Print.  
    @Print               BIT          = 1,          
    @FileGroupName       VARCHAR(128) = 'PartitionFG'    -- Filegroup for new partitions / switchout tables (SlidingWindow, Cleanup)  
AS  
BEGIN  
  
    SET NOCOUNT ON;  
  
    /*  
    ================================================================================  
    usp_PartitionMaintenance - simplified  
  
    This procedure performs exactly ONE task per call, selected via @Action:  
  
      'SlidingWindow' - Create the next partition boundary (based on @NextPartitionAfter)  
                         for @TableName (or all date-partitioned tables if @TableName = '%').  
  
      'SwitchOut'     - Switch out and drop the data in partitions older than  
                         @CleanupOlderThan for @TableName (or all matching tables if  
                         @TableName = '%'). Does NOT merge the partition range/boundary -  
                         run @Action='MergeRange' separately for that.  
  
      'MergeRange'    - Merge partition function boundaries older than @CleanupOlderThan,  
                         but ONLY for boundaries that are confirmed empty (0 rows) across  
                         EVERY table sharing that partition scheme/function. This is kept  
                         as its own action because a scheme/function can be shared by  
                         multiple tables - merging while any one of them still has data on  
                         that boundary will block/fail. Run 'SwitchOut' for all such tables  
                         first, then run 'MergeRange'.  
  
      'Info'          - Report detailed partition information for tables matching @TableName.  
  
      'Aligned'       - Report which partitioned indexes are partition-aligned.  
  
    @Execute and @Print are independent switches (not mutually exclusive):  
      - @Print = 1   prints every generated command (default ON, for visibility/audit).  
      - @Execute = 1 actually runs the generated commands (default OFF, dry-run).  
    Run one action per call instead of toggling multiple flags together.  
    ================================================================================  
    */  
  
    SET @TableName = ISNULL(@TableName, '%');  
    IF @TableName = ''  
        SET @TableName = '%';  
  
    IF @Action NOT IN ('SlidingWindow', 'SwitchOut', 'MergeRange', 'Info', 'Aligned')  
    BEGIN  
        RAISERROR('Invalid @Action ''%s''. Use one of: SlidingWindow, SwitchOut, MergeRange, Info, Aligned.', 16, 1, @Action);  
        RETURN;  
    END  
  
    PRINT '-- Partition Maintenance: Action=' + @Action + ', TableName=' + @TableName  
        + ', Execute=' + CASE WHEN @Execute = 1 THEN 'YES' ELSE 'NO' END  
        + ', Print=' + CASE WHEN @Print = 1 THEN 'YES' ELSE 'NO' END;  
  
  
    ------------------------------------------------------------------------------  
    -- ACTION: SlidingWindow - create the next partition boundary  
    ------------------------------------------------------------------------------  
    IF @Action = 'SlidingWindow'  
    BEGIN  
        DECLARE @NextValue INT;  
        DECLARE @NextUnit CHAR(1);  
        DECLARE @IsNegative BIT = 0;  
        DECLARE @NextPartitionDate DATE;  
        DECLARE @TempNextPartitionAfter VARCHAR(10) = @NextPartitionAfter;  
  
        IF LEFT(@NextPartitionAfter, 1) = '-'  
        BEGIN  
            SET @IsNegative = 1;  
            SET @TempNextPartitionAfter = SUBSTRING(@NextPartitionAfter, 2, LEN(@NextPartitionAfter) - 1);  
        END  
  
        SET @NextValue = CAST(LEFT(@TempNextPartitionAfter, LEN(@TempNextPartitionAfter) - 1) AS INT);  
        SET @NextUnit = LOWER(RIGHT(@TempNextPartitionAfter, 1));  
        IF @IsNegative = 1 SET @NextValue = -@NextValue;  
  
        IF @NextUnit = 'd' SET @NextPartitionDate = DATEADD(DAY, @NextValue, GETDATE());  
        ELSE IF @NextUnit = 'm' SET @NextPartitionDate = DATEADD(MONTH, @NextValue, GETDATE());  
        ELSE IF @NextUnit = 'y' SET @NextPartitionDate = DATEADD(YEAR, @NextValue, GETDATE());  
        ELSE  
        BEGIN  
            RAISERROR('Invalid @NextPartitionAfter format. Use {number}{unit} where unit is d=days, m=months, y=years. Examples: 30d, 6m, 1y, -3m', 16, 1);  
            RETURN;  
        END  
  
        IF NOT EXISTS (SELECT 1 FROM sys.filegroups WHERE name = @FileGroupName)  
        BEGIN  
            PRINT 'ERROR: Filegroup [' + @FileGroupName + '] does not exist. Available filegroups:';  
            SELECT name AS AvailableFileGroups FROM sys.filegroups ORDER BY name;  
            RAISERROR('Cannot proceed with invalid filegroup.', 16, 1);  
            RETURN;  
        END  
  
        PRINT '-- Creating partition boundary for ' + CONVERT(VARCHAR(10), @NextPartitionDate, 120);  
  
        BEGIN TRY  
            DECLARE @sql NVARCHAR(MAX);  
            DECLARE @CurrSchemeID INT, @CurrScheme VARCHAR(128), @CurrFunctionID INT, @CurrFunction VARCHAR(128);  
            DECLARE @BoundaryAlreadyExists BIT;  
  
            CREATE TABLE #PartitionFunctions (  
                SchemeID INT, SchemeName NVARCHAR(128), FunctionID INT, FunctionName NVARCHAR(128), IsDateBased BIT  
            );  
  
            INSERT INTO #PartitionFunctions (SchemeID, SchemeName, FunctionID, FunctionName, IsDateBased)  
            SELECT DISTINCT  
                s.data_space_id, s.name, f.function_id, f.name,  
                CASE WHEN EXISTS (  
                    SELECT 1 FROM sys.partition_range_values r  
                    WHERE r.function_id = f.function_id  
                    AND SQL_VARIANT_PROPERTY(r.value, 'BaseType') IN ('date', 'datetime', 'datetime2', 'datetimeoffset', 'smalldatetime')  
                ) THEN 1 ELSE 0 END  
            FROM sys.partition_schemes s  
            JOIN sys.partition_functions f ON s.function_id = f.function_id;  
  
            DECLARE @SlideCursor CURSOR;  
            -- NOTE: cursor *variables* assigned via SET cannot use the LOCAL keyword  
            -- (only FORWARD_ONLY/FAST_FORWARD/etc. options are valid here).  
            IF @TableName = '%'  
                SET @SlideCursor = CURSOR FAST_FORWARD FOR  
                    SELECT SchemeID, SchemeName, FunctionID, FunctionName FROM #PartitionFunctions WHERE IsDateBased = 1;  
            ELSE  
                SET @SlideCursor = CURSOR FAST_FORWARD FOR  
                    SELECT pf.SchemeID, pf.SchemeName, pf.FunctionID, pf.FunctionName  
                    FROM sys.tables tab  
                    INNER JOIN sys.indexes i ON tab.object_id = i.object_id AND i.index_id <= 1  
                    INNER JOIN #PartitionFunctions pf ON i.data_space_id = pf.SchemeID  
                    WHERE tab.name = @TableName AND pf.IsDateBased = 1;  
  
            OPEN @SlideCursor;  
            FETCH NEXT FROM @SlideCursor INTO @CurrSchemeID, @CurrScheme, @CurrFunctionID, @CurrFunction;  
  
            IF @@FETCH_STATUS <> 0  
                PRINT 'No date-based partitioned table/function found matching [' + @TableName + '].';  
  
            WHILE @@FETCH_STATUS = 0  
            BEGIN  
                SET @BoundaryAlreadyExists = CASE WHEN EXISTS (  
                    SELECT 1 FROM sys.partition_range_values v  
                    WHERE v.function_id = @CurrFunctionID  
                    AND CONVERT(DATE, v.value) = @NextPartitionDate  
                ) THEN 1 ELSE 0 END;  
  
                IF @BoundaryAlreadyExists = 1  
                    PRINT '-- Boundary for ' + CONVERT(VARCHAR(10), @NextPartitionDate, 120) +  
                        ' already exists in function [' + @CurrFunction + ']. Skipping.';  
                ELSE  
                BEGIN  
                    SET @sql = 'ALTER PARTITION SCHEME [' + @CurrScheme + '] NEXT USED [' + @FileGroupName + ']';  
                    IF @Print = 1 PRINT @sql;  
                    IF @Execute = 1 EXEC sp_executesql @sql;  
  
                    SET @sql = 'ALTER PARTITION FUNCTION [' + @CurrFunction + ']() SPLIT RANGE (''' +  
                        CONVERT(VARCHAR(23), @NextPartitionDate, 121) + ''')';  
                    IF @Print = 1 PRINT @sql;  
                    IF @Execute = 1 EXEC sp_executesql @sql;  
                END  
  
                FETCH NEXT FROM @SlideCursor INTO @CurrSchemeID, @CurrScheme, @CurrFunctionID, @CurrFunction;  
            END  
            CLOSE @SlideCursor; DEALLOCATE @SlideCursor;  
  
            DROP TABLE #PartitionFunctions;  
        END TRY  
        BEGIN CATCH  
            DECLARE @SlideErrMsg NVARCHAR(4000) = ERROR_MESSAGE();  
            IF OBJECT_ID('tempdb..#PartitionFunctions') IS NOT NULL DROP TABLE #PartitionFunctions;  
            RAISERROR('SlidingWindow failed: %s', 16, 1, @SlideErrMsg);  
        END CATCH  
    END  
  
    ------------------------------------------------------------------------------  
    -- ACTION: SwitchOut - switch out and drop old partition data (no merge)  
    ------------------------------------------------------------------------------  
    ELSE IF @Action = 'SwitchOut'  
    BEGIN  
        DECLARE @CleanupValue INT;  
        DECLARE @CleanupUnit CHAR(1);  
        DECLARE @CleanupDate DATE;  
  
        SET @CleanupValue = CAST(LEFT(@CleanupOlderThan, LEN(@CleanupOlderThan) - 1) AS INT);  
        SET @CleanupUnit = LOWER(RIGHT(@CleanupOlderThan, 1));  
  
        IF @CleanupUnit = 'd' SET @CleanupDate = DATEADD(DAY, -@CleanupValue, GETDATE());  
        ELSE IF @CleanupUnit = 'm' SET @CleanupDate = DATEADD(MONTH, -@CleanupValue, GETDATE());  
        ELSE IF @CleanupUnit = 'y' SET @CleanupDate = DATEADD(YEAR, -@CleanupValue, GETDATE());  
        ELSE  
        BEGIN  
            RAISERROR('Invalid @CleanupOlderThan format. Use {number}{unit} where unit is d=days, m=months, y=years. Examples: 30d, 6m, 1y', 16, 1);  
            RETURN;  
        END  
  
        IF NOT EXISTS (SELECT 1 FROM sys.filegroups WHERE name = @FileGroupName)  
        BEGIN  
            PRINT 'ERROR: Filegroup [' + @FileGroupName + '] does not exist. Available filegroups:';  
            SELECT name AS AvailableFileGroups FROM sys.filegroups ORDER BY name;  
            RAISERROR('Cannot proceed with invalid filegroup.', 16, 1);  
            RETURN;  
        END  
  
        PRINT '-- Switching out partitions older than ' + CONVERT(VARCHAR(10), @CleanupDate, 120)  
            + ' (this does NOT merge the partition range - run @Action=''MergeRange'' afterward).';  
  
        DECLARE @partition_number INT;  
        DECLARE @csql NVARCHAR(MAX);  
        DECLARE @rows BIGINT;  
        DECLARE @SwitchoutTableName VARCHAR(128);  
        DECLARE @CurrentSchema VARCHAR(128);  
        DECLARE @CurrentObjID INT;  
        DECLARE @TableCompression VARCHAR(128);  
        DECLARE @CurrentTableName VARCHAR(128);  
        DECLARE @CurrentFileGroupName VARCHAR(128);  
  
        BEGIN TRY  
            IF OBJECT_ID('tempdb..#PartitionsToProcess') IS NOT NULL DROP TABLE #PartitionsToProcess;  
            CREATE TABLE #PartitionsToProcess (  
                RowId INT IDENTITY(1,1), TableName VARCHAR(128), SchemaName VARCHAR(128), BoundaryValue SQL_VARIANT,  
                PartitionFunctionName VARCHAR(128), PartitionSchemeName VARCHAR(128), RowCnt BIGINT,  
 PartitionNumber INT, DataCompression VARCHAR(50), ObjectID INT  
            );  
  
            INSERT INTO #PartitionsToProcess (TableName, SchemaName, BoundaryValue, PartitionFunctionName, PartitionSchemeName, RowCnt, PartitionNumber, DataCompression, ObjectID)  
            SELECT DISTINCT t.name, SCHEMA_NAME(t.schema_id), r.value, f.name, s.name, p.rows, p.partition_number, p.data_compression_desc, t.object_id  
            FROM sys.tables AS t  
                INNER JOIN sys.indexes AS i ON t.object_id = i.object_id  
                INNER JOIN sys.partitions AS p ON i.object_id = p.object_id AND i.index_id = p.index_id  
                INNER JOIN sys.partition_schemes AS s ON i.data_space_id = s.data_space_id  
                INNER JOIN sys.partition_functions AS f ON s.function_id = f.function_id  
                LEFT OUTER JOIN sys.partition_range_values AS r ON f.function_id = r.function_id AND r.boundary_id = p.partition_number  
            WHERE t.name LIKE @TableName AND i.type <= 1 AND p.partition_number > 1 AND r.value < @CleanupDate  
              AND p.partition_number < (SELECT MAX(p2.partition_number) FROM sys.partitions p2 WHERE p2.object_id = i.object_id)  
            ORDER BY t.name, partition_number;  
  
            IF NOT EXISTS (SELECT 1 FROM #PartitionsToProcess)  
                PRINT 'No partitions older than ' + CONVERT(VARCHAR(10), @CleanupDate, 120) + ' found for [' + @TableName + '].';  
  
            DECLARE @PartitionCursor CURSOR;  
            SET @PartitionCursor = CURSOR FAST_FORWARD FOR  
                SELECT TableName, SchemaName, RowCnt, PartitionNumber, DataCompression, ObjectID  
                FROM #PartitionsToProcess;  
  
            OPEN @PartitionCursor;  
            FETCH NEXT FROM @PartitionCursor INTO @CurrentTableName, @CurrentSchema, @rows, @partition_number, @TableCompression, @CurrentObjID;  
  
            WHILE @@FETCH_STATUS = 0  
            BEGIN  
                SET @SwitchoutTableName = @CurrentTableName + '_SW_P' + CAST(@partition_number AS VARCHAR(10));  
                SET @CurrentFileGroupName = @FileGroupName;  
  
                BEGIN TRY  
                    IF @Print = 1  
                    BEGIN  
                        PRINT '';  
                        PRINT '-- Processing partition #' + CAST(@partition_number AS VARCHAR(10)) + ' for table [' + @CurrentSchema + '].[' + @CurrentTableName + ']';  
                    END  
  
                    SET @csql = 'IF OBJECT_ID(''' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + ''') IS NOT NULL DROP TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName);  
                    IF @Print = 1 PRINT @csql;  
                    IF @Execute = 1 EXEC sp_executesql @csql;  
  
                    DECLARE @TableCreateSql NVARCHAR(MAX) = 'CREATE TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + ' (';  
                    SELECT @TableCreateSql += QUOTENAME(c.name) + ' ' + types.name +  
                        CASE WHEN types.name IN ('varchar', 'nvarchar', 'char', 'nchar') THEN '(' + CASE WHEN c.max_length = -1 THEN 'MAX' ELSE CAST(CASE WHEN types.name IN ('nvarchar', 'nchar') THEN c.max_length / 2 ELSE c.max_length END AS VARCHAR(10)) 
END + ')'  
                             WHEN types.name IN ('decimal', 'numeric') THEN '(' + CAST(c.precision AS VARCHAR(10)) + ', ' + CAST(c.scale AS VARCHAR(10)) + ')' ELSE '' END +  
                        CASE WHEN c.is_nullable = 0 THEN ' NOT NULL' ELSE ' NULL' END + ', '  
                    FROM sys.columns c JOIN sys.types ON c.system_type_id = types.system_type_id AND c.user_type_id = types.user_type_id  
                    WHERE object_id = @CurrentObjID ORDER BY column_id;  
  
                    SET @TableCreateSql = LEFT(@TableCreateSql, LEN(@TableCreateSql) - 1) + ') ON ' + QUOTENAME(@CurrentFileGroupName);  
                    IF @TableCompression != 'NONE' SET @TableCreateSql += ' WITH (DATA_COMPRESSION = ' + @TableCompression + ')';  
                    IF @Print = 1 PRINT @TableCreateSql;  
                    IF @Execute = 1 EXEC sp_executesql @TableCreateSql;  
  
                    DECLARE @IdxID INT, @IdxName SYSNAME, @IsUnique BIT, @IdxTypeDesc VARCHAR(60), @IsPK BIT;  
                    DECLARE IndexCursor CURSOR LOCAL FAST_FORWARD FOR  
                        SELECT index_id, name, is_unique, type_desc, is_primary_key FROM sys.indexes WHERE object_id = @CurrentObjID AND type > 0;  
  
                    OPEN IndexCursor;  
                    FETCH NEXT FROM IndexCursor INTO @IdxID, @IdxName, @IsUnique, @IdxTypeDesc, @IsPK;  
                    WHILE @@FETCH_STATUS = 0  
                    BEGIN  
                        DECLARE @IdxSQL NVARCHAR(MAX) = '';  
                        DECLARE @UniqueConstraintName SYSNAME = LEFT(@IdxName, 100) + '_SW_P' + CAST(@partition_number AS VARCHAR(10));  
                        IF @IsPK = 1  
                            SET @IdxSQL = 'ALTER TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + ' ADD CONSTRAINT ' + QUOTENAME(@UniqueConstraintName) + ' PRIMARY KEY ' + @IdxTypeDesc + ' (';  
                        ELSE  
                            SET @IdxSQL = 'CREATE ' + CASE WHEN @IsUnique = 1 THEN 'UNIQUE ' ELSE '' END + @IdxTypeDesc + ' INDEX ' + QUOTENAME(@UniqueConstraintName) + ' ON ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + ' (';  
  
                        SELECT @IdxSQL += QUOTENAME(c.name) + CASE WHEN ic.is_descending_key = 1 THEN ' DESC, ' ELSE ' ASC, ' END  
                        FROM sys.index_columns ic JOIN sys.columns c ON ic.object_id = c.object_id AND ic.column_id = c.column_id  
                        WHERE ic.object_id = @CurrentObjID AND ic.index_id = @IdxID AND ic.is_included_column = 0 ORDER BY ic.key_ordinal;  
                        SET @IdxSQL = LEFT(@IdxSQL, LEN(@IdxSQL) - 1) + ')';  
  
                        IF EXISTS (SELECT 1 FROM sys.index_columns WHERE object_id = @CurrentObjID AND index_id = @IdxID AND is_included_column = 1)  
                        BEGIN  
                            SET @IdxSQL += ' INCLUDE (';  
                            SELECT @IdxSQL += QUOTENAME(c.name) + ', '  
                            FROM sys.index_columns ic JOIN sys.columns c ON ic.object_id = c.object_id AND ic.column_id = c.column_id  
                            WHERE ic.object_id = @CurrentObjID AND ic.index_id = @IdxID AND is_included_column = 1 ORDER BY ic.index_column_id;  
                            SET @IdxSQL = LEFT(@IdxSQL, LEN(@IdxSQL) - 1) + ')';  
                        END  
  
                        -- NOTE: for CREATE INDEX / ADD CONSTRAINT PRIMARY KEY, WITH (options) must come  
                        -- BEFORE the ON <filegroup> clause (opposite order from CREATE TABLE).  
                        IF @TableCompression != 'NONE' SET @IdxSQL += ' WITH (DATA_COMPRESSION = ' + @TableCompression + ')';  
                        SET @IdxSQL += ' ON ' + QUOTENAME(@CurrentFileGroupName);  
                        IF @Print = 1 PRINT @IdxSQL;  
                        IF @Execute = 1 EXEC sp_executesql @IdxSQL;  
  
                        FETCH NEXT FROM IndexCursor INTO @IdxID, @IdxName, @IsUnique, @IdxTypeDesc, @IsPK;  
                    END  
                    CLOSE IndexCursor; DEALLOCATE IndexCursor;  
  
                    SET @csql = 'ALTER TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@CurrentTableName) + ' SWITCH PARTITION ' + CAST(@partition_number AS VARCHAR(10)) + ' TO ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + '
;';  
                    IF @Print = 1 PRINT @csql;  
                    IF @Execute = 1 EXEC sp_executesql @csql;  
  
                    SET @csql = 'DROP TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName);  
                    IF @Print = 1 PRINT @csql;  
                    IF @Execute = 1 EXEC sp_executesql @csql;  
  
                END TRY  
                BEGIN CATCH  
                    PRINT '-- [ERROR] Partition processing failed for #' + CAST(@partition_number AS VARCHAR(10)) + ': ' + ERROR_MESSAGE();  
  
                    IF (SELECT CURSOR_STATUS('local', 'IndexCursor')) >= 0  
                    BEGIN  
                        CLOSE IndexCursor;  
                        DEALLOCATE IndexCursor;  
                    END  
  
                    SET @csql = 'IF OBJECT_ID(''' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName) + ''') IS NOT NULL DROP TABLE ' + QUOTENAME(@CurrentSchema) + '.' + QUOTENAME(@SwitchoutTableName);  
                    IF @Execute = 1 EXEC sp_executesql @csql;  
                END CATCH;  
  
                FETCH NEXT FROM @PartitionCursor INTO @CurrentTableName, @CurrentSchema, @rows, @partition_number, @TableCompression, @CurrentObjID;  
            END  
            CLOSE @PartitionCursor; DEALLOCATE @PartitionCursor;  
  
            DROP TABLE #PartitionsToProcess;  
        END TRY  
        BEGIN CATCH  
            DECLARE @CleanupErrMsg NVARCHAR(4000) = ERROR_MESSAGE();  
            DECLARE @CleanupErrLine INT = ERROR_LINE();  
            PRINT '-- ERROR OCCURRED at line ' + CAST(@CleanupErrLine AS VARCHAR(10)) + ': ' + @CleanupErrMsg;  
  
            IF OBJECT_ID('tempdb..#PartitionsToProcess') IS NOT NULL DROP TABLE #PartitionsToProcess;  
  
            -- Best-effort cleanup of any leftover switchout tables so the next run isn't blocked  
            IF @Execute = 1  
            BEGIN  
                DECLARE @LeftoverTable VARCHAR(128);  
                DECLARE @LeftoverSchema VARCHAR(128);  
                DECLARE @LeftoverDropSql NVARCHAR(MAX);  
                DECLARE @LeftoverCursor CURSOR  
                    SELECT SCHEMA_NAME(schema_id), name FROM sys.tables WHERE name LIKE '%\_SW\_P%' ESCAPE '\';  
                OPEN @LeftoverCursor;  
                FETCH NEXT FROM @LeftoverCursor INTO @LeftoverSchema, @LeftoverTable;  
                WHILE @@FETCH_STATUS = 0  
                BEGIN  
                    BEGIN TRY  
                        PRINT '-- Dropping leftover switchout table: ' + @LeftoverSchema + '.' + @LeftoverTable;  
                        SET @LeftoverDropSql = 'DROP TABLE ' + QUOTENAME(@LeftoverSchema) + '.' + QUOTENAME(@LeftoverTable);  
                        EXEC sp_executesql @LeftoverDropSql;  
                    END TRY  
                    BEGIN CATCH  
                        PRINT '-- Failed to drop ' + @LeftoverTable + ': ' + ERROR_MESSAGE();  
                    END CATCH  
                    FETCH NEXT FROM @LeftoverCursor INTO @LeftoverSchema, @LeftoverTable;  
                END  
                CLOSE @LeftoverCursor; DEALLOCATE @LeftoverCursor;  
            END  
  
            RAISERROR('SwitchOut failed: %s', 16, 1, @CleanupErrMsg);  
        END CATCH  
    END  
  
    ------------------------------------------------------------------------------  
    -- ACTION: MergeRange - merge partition function boundaries that are confirmed  
    --         empty (0 rows) across EVERY table sharing that scheme/function.  
    --         Kept separate from SwitchOut because a shared scheme/function can  
    --         belong to multiple tables - merging while any one of them still  
    --         has data on that boundary will block/fail.  
    ------------------------------------------------------------------------------  
    ELSE IF @Action = 'MergeRange'  
    BEGIN  
        DECLARE @MergeCleanupValue INT;  
        DECLARE @MergeCleanupUnit CHAR(1);  
        DECLARE @MergeCleanupDate DATE;  
  
        SET @MergeCleanupValue = CAST(LEFT(@CleanupOlderThan, LEN(@CleanupOlderThan) - 1) AS INT);  
        SET @MergeCleanupUnit = LOWER(RIGHT(@CleanupOlderThan, 1));  
  
        IF @MergeCleanupUnit = 'd' SET @MergeCleanupDate = DATEADD(DAY, -@MergeCleanupValue, GETDATE());  
        ELSE IF @MergeCleanupUnit = 'm' SET @MergeCleanupDate = DATEADD(MONTH, -@MergeCleanupValue, GETDATE());  
        ELSE IF @MergeCleanupUnit = 'y' SET @MergeCleanupDate = DATEADD(YEAR, -@MergeCleanupValue, GETDATE());  
        ELSE  
        BEGIN  
            RAISERROR('Invalid @CleanupOlderThan format. Use {number}{unit} where unit is d=days, m=months, y=years. Examples: 30d, 6m, 1y', 16, 1);  
            RETURN;  
        END  
  
        PRINT '-- Merging partition ranges older than ' + CONVERT(VARCHAR(10), @MergeCleanupDate, 120)  
            + ' that are empty across ALL tables sharing the scheme/function.';  
        PRINT '-- Run @Action=''SwitchOut'' for every such table first, or this merge will skip/block on boundaries still holding data.';  
  
        DECLARE @MergeFunctionID INT, @MergeFunctionName VARCHAR(128), @MergeBoundary SQL_VARIANT, @MergeBoundaryStr VARCHAR(MAX);  
        DECLARE @MergeSql NVARCHAR(MAX);  
  
        BEGIN TRY  
            IF OBJECT_ID('tempdb..#BoundariesToMerge') IS NOT NULL DROP TABLE #BoundariesToMerge;  
            CREATE TABLE #BoundariesToMerge (FunctionID INT, FunctionName VARCHAR(128), BoundaryValue SQL_VARIANT, BoundaryID INT);  
  
            -- Boundaries older than the cutoff, for functions used by at least one table  
            -- matching @TableName, where NO partition using that boundary (across ANY  
            -- table sharing the scheme) still has rows.  
            INSERT INTO #BoundariesToMerge (FunctionID, FunctionName, BoundaryValue, BoundaryID)  
            SELECT DISTINCT f.function_id, f.name, r.value, r.boundary_id  
            FROM sys.partition_functions f  
            JOIN sys.partition_range_values r ON r.function_id = f.function_id  
            JOIN sys.partition_schemes s ON s.function_id = f.function_id  
            WHERE r.value < @MergeCleanupDate  
              AND EXISTS (  
                    SELECT 1 FROM sys.tables t  
                    INNER JOIN sys.indexes i ON t.object_id = i.object_id AND i.index_id <= 1  
                    WHERE i.data_space_id = s.data_space_id AND t.name LIKE @TableName  
              )  
              AND NOT EXISTS (  
                    SELECT 1  
                    FROM sys.tables t2  
                    INNER JOIN sys.indexes i2 ON t2.object_id = i2.object_id  
                    INNER JOIN sys.partitions p2 ON i2.object_id = p2.object_id AND i2.index_id = p2.index_id  
                    WHERE i2.data_space_id = s.data_space_id  
                      AND i2.type <= 1  
                      AND p2.partition_number = r.boundary_id  
                      AND p2.rows > 0  
              );  
  
            IF NOT EXISTS (SELECT 1 FROM #BoundariesToMerge)  
                PRINT 'No mergeable (empty, older than cutoff) partition boundaries found for [' + @TableName + '].';  
  
            DECLARE @MergeCursor CURSOR;  
            SET @MergeCursor = CURSOR FAST_FORWARD FOR  
                SELECT FunctionID, FunctionName, BoundaryValue FROM #BoundariesToMerge;  
  
            OPEN @MergeCursor;  
            FETCH NEXT FROM @MergeCursor INTO @MergeFunctionID, @MergeFunctionName, @MergeBoundary;  
            WHILE @@FETCH_STATUS = 0  
            BEGIN  
                BEGIN TRY  
                    SET @MergeBoundaryStr = CASE WHEN SQL_VARIANT_PROPERTY(@MergeBoundary, 'basetype') = 'datetimeoffset'  
                        THEN FORMAT(CAST(@MergeBoundary AS DATETIMEOFFSET(7)), 'yyyy-MM-dd HH:mm:ss.fffffff zzz')  
                        ELSE CONVERT(VARCHAR(23), @MergeBoundary, 121) END;  
                    SET @MergeSql = 'ALTER PARTITION FUNCTION ' + QUOTENAME(@MergeFunctionName) + '() MERGE RANGE (''' + @MergeBoundaryStr + ''');';  
                    IF @Print = 1 PRINT @MergeSql;  
                    IF @Execute = 1 EXEC sp_executesql @MergeSql;  
                END TRY  
                BEGIN CATCH  
                    PRINT '-- [ERROR] Merge failed for function [' + @MergeFunctionName + '] boundary ' + ISNULL(@MergeBoundaryStr, '') + ': ' + ERROR_MESSAGE();  
                END CATCH  
  
                FETCH NEXT FROM @MergeCursor INTO @MergeFunctionID, @MergeFunctionName, @MergeBoundary;  
            END  
            CLOSE @MergeCursor; DEALLOCATE @MergeCursor;  
  
            DROP TABLE #BoundariesToMerge;  
        END TRY  
        BEGIN CATCH  
            DECLARE @MergeErrMsg NVARCHAR(4000) = ERROR_MESSAGE();  
            IF OBJECT_ID('tempdb..#BoundariesToMerge') IS NOT NULL DROP TABLE #BoundariesToMerge;  
            RAISERROR('MergeRange failed: %s', 16, 1, @MergeErrMsg);  
        END CATCH  
    END  
  
    ------------------------------------------------------------------------------  
    -- ACTION: Info - detailed partition information report  
    ------------------------------------------------------------------------------  
    ELSE IF @Action = 'Info'  
    BEGIN  
        PRINT '-- Partition information for tables matching [' + @TableName + ']';  
        SELECT DISTINCT  
            t.name TName,  
            f.name PFName,  
            s.name PSName,  
            r.value PSRange,  
            SQL_VARIANT_PROPERTY(r.value, 'BaseType') AS [Base Type],  
            SQL_VARIANT_PROPERTY(r.value, 'Precision') AS [Precision],  
            SQL_VARIANT_PROPERTY(r.value, 'Scale') AS [Scale],  
            c.name PartitionColumn,  
            p.rows RowsCount,  
            p.partition_number,  
            p.data_compression_desc  
        FROM sys.tables AS t  
            INNER JOIN sys.indexes AS i ON t.object_id = i.object_id  
            INNER JOIN sys.partitions AS p ON i.object_id = p.object_id AND i.index_id = p.index_id  
            INNER JOIN sys.partition_schemes AS s ON i.data_space_id = s.data_space_id  
            INNER JOIN sys.partition_functions AS f ON s.function_id = f.function_id  
            LEFT OUTER JOIN sys.partition_range_values AS r ON f.function_id = r.function_id AND r.boundary_id = p.partition_number  
            LEFT JOIN sys.index_columns AS ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.partition_ordinal >= 1  
            LEFT JOIN sys.columns AS c ON t.object_id = c.object_id AND ic.column_id = c.column_id  
        WHERE i.type <= 1  
            AND t.name LIKE @TableName  
        ORDER BY t.name, p.partition_number;  
    END  
  
    ------------------------------------------------------------------------------  
    -- ACTION: Aligned - partition alignment report for indexes  
    ------------------------------------------------------------------------------  
    ELSE IF @Action = 'Aligned'  
    BEGIN  
        PRINT '-- Partition alignment report for indexes';  
  
        IF OBJECT_ID('tempdb..#IdxSize') IS NOT NULL DROP TABLE #IdxSize;  
  
        SELECT i.name AS IndexName, SUM(s.used_page_count) * 8 AS IndexSizeKB  
        INTO #IdxSize  
        FROM sys.dm_db_partition_stats AS s  
        INNER JOIN sys.indexes AS i ON s.object_id = i.object_id AND s.index_id = i.index_id  
        GROUP BY i.name;  
  
        ;WITH CTE_PartCount AS (  
            SELECT p.object_id, p.index_id, COUNT(p.partition_number) AS PartitionCount  
            FROM sys.partitions AS p  
            GROUP BY p.object_id, p.index_id  
        ),  
        CTE_Objects AS (  
            SELECT o.object_id, o.name AS ObjectName, sc.name AS SchemaName, i.index_id, i.name AS IndexName, i.type_desc AS IndexType  
            FROM sys.objects AS o  
                INNER JOIN sys.schemas AS sc ON sc.schema_id = o.schema_id  
                INNER JOIN sys.indexes AS i ON i.object_id = o.object_id  
            WHERE o.is_ms_shipped = 0 AND o.type_desc = 'USER_TABLE'  
        ),  
        CTE_Summary AS (  
            SELECT o.object_id, o.ObjectName, o.SchemaName, o.IndexName, o.IndexType, pc.PartitionCount,  
                TablePartCount = FIRST_VALUE(pc.PartitionCount) OVER (PARTITION BY o.object_id ORDER BY o.object_id, o.index_id)  
            FROM CTE_Objects AS o  
                LEFT OUTER JOIN CTE_PartCount AS pc ON pc.object_id = o.object_id AND pc.index_id = o.index_id  
        )  
        SELECT s.object_id, s.SchemaName, s.ObjectName, s.IndexName, t.IndexSizeKB, s.IndexType, s.PartitionCount,  
            IsPartitioned = CASE WHEN s.TablePartCount <> 1 THEN 'YES' ELSE 'NO' END,  
            IsAligned = CASE WHEN s.TablePartCount = s.PartitionCount THEN 'ALIGNED' ELSE '' END  
        FROM CTE_Summary AS s  
        INNER JOIN #IdxSize T ON s.IndexName = T.IndexName  
        WHERE s.TablePartCount <> 1  
        ORDER BY IsAligned;  
  
        DROP TABLE #IdxSize;  
    END  
END  
